{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/codex-session-mapping.cjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
