{
  "name": "@ai-devkit/daemon-client",
  "version": "0.1.0",
  "description": "Thin client for the devkitd coordination daemon (unix socket, JSON-RPC, subscribe)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codeaholicguy/ai-devkit.git",
    "directory": "packages/daemon-client"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "swc src -d dist --strip-leading-paths && tsc --emitDeclarationOnly",
    "dev": "swc src -d dist --strip-leading-paths --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint src",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.10.0",
    "@types/node": "^20.11.5",
    "vitest": "^4.1.8"
  }
}
