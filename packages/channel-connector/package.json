{
  "name": "@ai-devkit/channel-connector",
  "version": "0.13.3",
  "description": "Generic messaging bridge for connecting to external communication platforms",
  "keywords": [
    "ai",
    "channel",
    "connector",
    "messaging",
    "telegram"
  ],
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codeaholicguy/ai-devkit.git",
    "directory": "packages/channel-connector"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "swc src -d dist --strip-leading-paths && tsc --emitDeclarationOnly",
    "dev": "swc src -d dist --strip-leading-paths --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint src",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@slack/socket-mode": "^3.0.0",
    "@slack/web-api": "^8.0.0",
    "marked": "^15.0.12",
    "telegraf": "^4.16.3",
    "uuid": "14.0.0"
  },
  "devDependencies": {
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.10.0",
    "@types/node": "^20.11.5",
    "@vitest/coverage-v8": "^4.1.8",
    "typescript": "^5.5.0",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20.20.0"
  },
  "nx": {
    "name": "channel-connector"
  }
}
